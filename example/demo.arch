# Two-storey demo house with a basement for arch_section.py.
plan "Demo" {
  units mm
  grid 5
  scale 1:50
  north up

  let W = 8000
  let D = 10000
  let XS = 5000      # stair hall | kitchen
  let YH = 3000      # stair hall | living
  let YK = 4000      # kitchen | room

  # --- section data (comments, ignored by ArchLang) ---
  # @section A x=700 look east      # in front of the first step: the flight full width, the turn behind
  # @section B y=650 look south     # along the flight: its steps from the side, the exit full width
  # @datum 0
  # @floor -1 Estrich:50 Bodenplatte:250
  # @floor 0 Fliesen:15 Estrich:65 Trittschall:30 Stahlbeton:180 Putz:15
  # @floor 1 Parkett:15 Estrich:60 Trittschall:40 Stahlbeton:160 Putz:15
  # @floor 2 Dielen:25 "Holzbalken mit Daemmung":200 Gipskarton:15
  # @ground -300

  component floorplan() {
    room id=hall at (0, 0) size XS x YH label "Treppenhaus" uses circulation
    room id=kitchen at (XS, 0) size (W - XS) x YK label "Küche" uses kitchen
    room id=living at (0, YH) size XS x (D - YH) label "Wohnen" uses living
    room id=room at (XS, YK) size (W - XS) x (D - YK) label "Zimmer" uses bedroom
    walls from rooms exterior 300 partition 115
    door at (XS, 2000) width 900 wall partition swing into kitchen
    door at (2000, YH) width 900 wall partition swing into living
    door at (XS, 7000) width 900 wall partition swing into room
    door at (0, 6000) width 1000 wall exterior
    window at (2500, D) width 1500 wall exterior
    window at (W, 7000) width 1500 wall exterior sill 500 head 2250
    window at (6500, 0) width 1200 wall exterior
    # like the real house: along the north wall, climbs west -> east, the winders turn south
    # (`winders` needs the ArchLang branch feat/stair-winders)
    stair id=tr dir up width 1000 {
      flight at (1200, 150) size 2700x1000
      landing at (3900, 150) size 1000x1000 winders 4
      flight at (3900, 1150) size 1000x560
    }
  }

  level -1 "Keller" height 2600 { floorplan() }
  level 0 "Erdgeschoss" height 2850 { floorplan() }
  level 1 "Obergeschoss" height 2750 { floorplan() }
}
