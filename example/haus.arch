# Haus: Keller, Erdgeschoss, Obergeschoss with the identical floor plan of eg.arch.
# Rooms are wall-CENTERLINE boxes (ArchLang convention), mm, origin top-left, y down.
# Storey heights = floor-to-floor (top finished floor to top finished floor).
# Measured 2026-11-06: clear heights KG 2,19 m, EG/OG 2,34 m; every ceiling is
# concrete, total build-up incl. screed + floor finish 0,32 m.
#   H_xx = clear height + slab build-up of the ceiling above.
plan "Haus" {
  units mm
  grid 5
  paper A3 portrait
  scale 1:50
  north up
  dims auto all
  sheet text { decimal "," total "SUMME" }
  schedule rooms net

  # centerline grid (x right, y down)
  let XW = 0
  let XH = 3610      # west rooms | hall
  let XM = 5020      # hall | east rooms
  let XB = 6240      # WC/lobby | bath
  let XE = 8910
  let YN = 0
  let YWC = 1770     # WC | lobby
  let YST = 2435     # stairwell | kitchen/hall: 2.22 m clear (1.01 stair eye + 1.21 hall), measured
  let YBA = 3870     # bath/lobby | room NE
  let YKI = 5960     # kitchen | room W
  let YNE = 7650     # room NE | room SE
  let YLR = 8910     # room W/hall | living room
  # installation shaft in the lobby against the bath wall, 410 x 410 mm, from the basement floor
  # up through every storey: the only place on that wall clear of the bath door (y 2235-2985),
  # flush with the bath wall's face (x 6145) and the face of the wall to room NE (y 3795)
  let SX = 5735
  let SY = 3385
  let YS = 13000     # east side 13,28 m outside with 28 cm walls, measured 2026-11-06


  # --- vertical datum (measured 2026-11-06) ---
  let KG_CLEAR = 2190   # clear height basement
  let KG_SLAB  = 320    # ceiling KG|EG, concrete + screed + finish
  let EG_CLEAR = 2340   # clear height ground floor
  let EG_SLAB  = 320    # ceiling EG|OG
  let OG_CLEAR = 2340   # clear height upper floor
  let OG_SLAB  = 320    # ceiling OG|attic

  # --- section data for arch_section.py (comments, ignored by ArchLang) ---
  # @section A x=700 look east       # in front of the first step: the flight full width, the turn behind
  # @section B y=640 look south      # along the stair flight, WC, bath (cf. photo IMG_20261106_083237)
  # @datum 0
  # floor build-up top -> bottom in mm; level -1 = basement ground slab, level 2 = ceiling above OG.
  # Total 320 incl. floor finish confirmed 2026-11-06; only the split 80 / 240 is assumed.
  # @floor 0 Belag+Estrich:80 Stahlbeton:240
  # @floor 1 Belag+Estrich:80 Stahlbeton:240
  # @floor 2 Belag+Estrich:80 Stahlbeton:240
  # terrain roughly 0,2 m below FFB EG, estimated from the photo, not measured
  # @ground -200

  # some rooms change use per storey: lvl = the storey number (-1 basement, 0 ground, 1 upper floor)
  component grundriss(lvl) {
    room id=treppe at (XW, YN) size (XM - XW) x (YST - YN) label "Treppenhaus" uses circulation
    room id=wc at (XM, YN) size (XB - XM) x (YWC - YN) label "WC" uses wc
    room id=vorraum at (XM, YWC) size (XB - XM) x (YBA - YWC) label "Vorraum" uses hall
    if lvl == -1 {
      room id=bad at (XB, YN) size (XE - XB) x (YBA - YN) label "Waschkeller" uses utility
    }
    if lvl != -1 {
      room id=bad at (XB, YN) size (XE - XB) x (YBA - YN) label "Bad" uses bath
    }
    if lvl == -1 {
      room id=kueche at (XW, YST) size (XH - XW) x (YKI - YST) label "Tankraum" uses storage
    }
    if lvl != -1 {
      room id=kueche at (XW, YST) size (XH - XW) x (YKI - YST) label "Küche" uses kitchen
    }
    room id=flur at (XH, YST) size (XM - XH) x (YLR - YST) label "Flur" uses hall
    if lvl == -1 {
      room id=zw at (XW, YKI) size (XH - XW) x (YLR - YKI) label "Heizung" uses utility
    }
    if lvl == 0 {
      room id=zw at (XW, YKI) size (XH - XW) x (YLR - YKI) label "Kino" at (1900, 7150) uses living
    }
    if lvl == 1 {
      room id=zw at (XW, YKI) size (XH - XW) x (YLR - YKI) label "Esszimmer" uses dining
    }
    if lvl == -1 {
      room id=zno at (XM, YBA) size (XE - XM) x (YNE - YBA) label "Weinkeller" uses storage
    }
    if lvl != -1 {
      room id=zno at (XM, YBA) size (XE - XM) x (YNE - YBA) label "Schlafzimmer" uses bedroom
    }
    room id=zso at (XM, YNE) size (XE - XM) x (YS - YNE) label "Zimmer" uses bedroom
    room id=wz at (XW, YLR) size (XM - XW) x (YS - YLR) label "Wohnzimmer" uses living

    walls from rooms exterior 280 partition 150 {   # exterior walls 28 cm, measured
      between zw and flur thickness 130
      between kueche and flur thickness 130
      between kueche and treppe thickness 180
      between wc and bad thickness 190
      between vorraum and bad thickness 190
    }

    # windows (exterior, centre on the wall centerline); only the living room one is measured
    window at (3615, YS) width 1060 wall exterior
    window at (XW, 4740) width 1070 wall exterior   # kitchen: 1070 wide, two casements 470 each; 610 from the south wall face y 5885 (measured)
    window at (XW, 6810) width 1150 wall exterior
    window at (5720, YS) width 1050 wall exterior
    window at (XE, 10635) width 1000 wall exterior
    window at (XE, 5560) width 1050 wall exterior
    window at (XE, 2035) width 1000 wall exterior

    # doors
    # west door of the living room: per level (terrace door 2000 double on the ground floor)
    door at (XW, 1735) width 900 wall exterior swing outward
    door at (4295, YLR) width 800 wall partition swing into wz
    # door hall -> room W: per level (walled up on the ground floor)
    door at (XH, 4255) width 800 wall partition swing into kueche
    door at (XM, 8235) width 800 wall partition swing into zso
    door at (XM, 5235) width 800 wall partition swing into zno
    door at (4295, YST) width 800 wall partition swing into treppe
    door at (5595, YWC) width 800 wall partition swing into wc
    door at (XB, 2610) width 750 wall partition swing into bad
    # hall -> lobby: open passage, no door leaf
    opening at (XM, 3168) width 1035 wall partition

    # stair along the north wall, climbs west -> east, winders at the top turn south
    # (ArchLang has no winders: modelled as quarter landing + short flight)
    stair id=tr dir up width 1000 {
      flight at (1195, 140) size 2700x1000
      landing at (3895, 140) size 1000x1000
      flight at (3895, 1140) size 1000x560
    }
    # chimney on the wall kitchen | room W: 1200 x 420 mm into room W (measured), flush with the
    # hall wall (the room door rests on its face). ArchLang has no chimney symbol: three brick
    # cells of 400 (1200 / 3), each with a stainless flue pipe of 100 mm in its centre (measured),
    # drawn as a shaft symbol in a 160 x 160 square.
    wall id=kamin1 chimney thickness 100 material brick { (2395, 6085) (2695, 6085) (2695, 6405) (2395, 6405) close }
    wall id=kamin2 chimney thickness 100 material brick { (2795, 6085) (3095, 6085) (3095, 6405) (2795, 6405) close }
    wall id=kamin3 chimney thickness 100 material brick { (3195, 6085) (3495, 6085) (3495, 6405) (3195, 6405) close }
    void id=rohr1 at (2465, 6165) size 160x160
    void id=rohr2 at (2865, 6165) size 160x160
    void id=rohr3 at (3265, 6165) size 160x160
  }

  level -1 "Keller" height KG_CLEAR + KG_SLAB {
    grundriss(-1)
    door at (XH, 6855) width 800 wall partition swing into zw   # open leaf rests flush on the chimney face (y 6455)
    door at (XW, 10985) width 1000 wall exterior swing into wz
    # the shaft stands on the basement floor: no hole in it, so drawn as its footprint
    furniture shaft at (SX, SY) size 410x410 label "Schacht"
  }
  level 0 "Erdgeschoss" height EG_CLEAR + EG_SLAB {
    grundriss(0)
    # the shaft passes through this storey's floor slab
    void id=schacht at (SX, SY) size 410x410
    # room W (cinema): the door to the hall is walled up; instead an archway 2000 wide to the living
    # room, centred in room W's clear width (faces x 140 and 3545 -> centre 1842,5, grid 5 -> 1845).
    # ArchLang has no arch shape: drawn as a leaf-less opening, head = wall height
    opening at (1845, YLR) width 2000 wall partition
    # terrace door, west wall of the living room: widened to 2000, two leaves of 1000 opening
    # inward, centre kept at y 10985 (y 9985-11985); the leaves sweep x 140-1140
    door double at (XW, 10985) width 2000 wall exterior swing into wz
    # corner sofa in the cinema (room W), north-west corner: long side 2350 on the west wall (faces x 140,
    # y 6035), short side 1900 on the kitchen wall towards the chimney (305 clear of it), 900 deep;
    # 450 left between its end and the south wall at the archway. The sofa_l symbol fixes its seat
    # depth at min(0.56 x short, 0.35 x long) = 822, so the legs are drawn 82 deep, not 90
    furniture sofa_l at (140, 6035) size 1900x2350 label "Eckcouch 235/190" rotate 270 mirror
    # display cabinet (Vitrine) in the cinema's north-east corner, across the corner between the
    # chimney's south face (y 6455) and the hall wall (face x 3545): a triangle whose legs are the
    # two faces, 1030 each, from the corner (3545, 6455) to (2515, 6455) and (3545, 7485); its
    # front on the 45 deg diagonal, 1457 long, 728 from the corner. Height 1740: 600 left free
    # below the ceiling (clear height EG_CLEAR 2340). Like the corner bath, ArchLang
    # has no triangular piece: the legs are the faces, the front a labelled dimension line (a
    # wall there would cut the triangle off the room)
    dim (2515, 6455) -> (3545, 7485) offset 0 text "Vitrine h 174"
    # projection screen on the cinema's east wall, between the display cabinet (ends y 7485) and
    # the south wall face (y 8835): 1350 free, screen 1320 wide centred in it (y 7500-8820),
    # image 1320 x 750 (about 16:9, 1.76:1). ArchLang has no screen symbol: drawn as a whiteboard 40 deep
    # (the housing) on the wall face; height and format only in the label (sections draw no furniture)
    furniture whiteboard at (3505, 7500) size 40x1320 label "Leinwand 132 x 75" rotate 90
    # the symbol is too thin to carry its label at 1:50: labelled by a dimension line in front of it
    dim (3465, 7500) -> (3465, 8820) offset 0 text "Leinwand 132/75"
    # projector, ceiling mount: lens 100 below the ceiling (h 2240 above FFB), x 1700 on the screen
    # axis y 8160, throw 1805 to the screen face x 3505 (throw ratio ~1.37 at 1320 wide). Screen
    # planned at h 950-1700 (seated eye ~1100). The lens is tilted ~27 deg down to the screen
    # centre: the image keystones ~18 % (bottom wider than top), corrected in the projector;
    # with the usual built-in 100 % offset ~17 deg / ~11 %, with ~70 % vertical lens shift none.
    # In plan the beam clears the cabinet front by ~200. ArchLang has no projector symbol:
    # drawn as a box 300 x 350 (lens on its east face) plus the beam's edge rays as dimension lines
    furniture box at (1400, 7985) size 300x350 label "Beamer"
    dim (1700, 8160) -> (3505, 7500) offset 0 text ""
    dim (1700, 8160) -> (3505, 8820) offset 0 text ""
    dim (1700, 8160) -> (3505, 8160) offset 0 text "Beamer h 224, 27°"
    # bedroom: double bed, two mattresses 90 x 190 (footprint 1800 x 1900 = mattresses, no frame),
    # head end on the south wall (face y 7575), centred in the clear width (faces x 5095 / 8770
    # -> 6932,5, grid 5 -> 6935); its foot end at y 5675 stays clear of the door leaf (to y 5635)
    furniture double_bed at (6035, 5675) size 1800x1900 label "Doppelbett 2 x 90/190" rotate 180
    # living room: dining table at right angles to the south window (window x 3085-4145),
    # 2000 x 900, y 10360-12360. Bench for 4 (2000 x 400) against the east wall (face x 4945),
    # the wall is its backrest; the table 50 off the bench, x 3595-4495, so it overlaps the
    # window width by 550. Three chairs on its west side and one at the south head, its back on
    # the window wall (y 12410-12860); the north head stays free.
    furniture id=esstisch table at (3595, 10360) size 900x2000 label "Esstisch"
    furniture bench at (4545, 10360) size 400x2000 label "Bank"
    furniture chair at (3095, 10468) size 450x450 facing esstisch
    furniture chair at (3095, 11135) size 450x450 facing esstisch
    furniture chair at (3095, 11802) size 450x450 facing esstisch
    furniture chair at (3820, 12410) size 450x450 facing esstisch
    # kitchen: U-shaped, 600 deep, open to the east (door to the hall on the east wall, y 3855-4655).
    # Clear faces: west x 140, east x 3545, north y 2525, south y 5885.
    # Base of the U on the west wall with the sink under the window (y 4205-5275): sink unit
    # 1000 long, y 3955-4955, seen from the user (facing west) the deep basin 430 on the left
    # (south, y 4525-4955), the rest 570 on the right only a drainer (north, y 3955-4525). The
    # basin is centred on the window centre y 4740, so its tap sits exactly mid-window and both
    # casements open past it. ArchLang's sink symbol is symmetric: drawn as a single-bowl sink
    # 430 plus a counter labelled as drainer. The two legs run along the north and south walls to the
    # east wall; 2160 clear between them, the door swing stays between the legs.
    # Fit-out after the usual kitchen planning rules (DIN 18022, AMK): dishwasher right beside
    # the sink, hob neither in a corner nor beside the tall unit, worktop on both sides of it,
    # fridge as a tall unit at the end of a leg; work triangle sink-hob-fridge about 6 m.
    # Hob + hood on the south leg near the west wall: the hood must be <= 1800 from the west
    # wall (its duct, 100 mm, runs along the south wall to the outside through the west wall).
    #   west leg:  corner counter 830 | dishwasher 600 | drainer 570 + basin 430 | counter 330 |
    #              corner counter 600
    #   south leg: counter 400 | hob 600 (centre x 1440 = 1300 from the west wall face) |
    #              counter 1205 | fridge tall unit 600
    #   north leg: counter run 1605 (storage), ends at x 2345; then a coffee corner for two:
    #              table 600 x 600 flush against the counter end (x 2345-2945), two simple
    #              stools 380 x 380 with a hand slot in the seat (ArchLang's stool symbol is round
    #              and has no slot: noted in the label): one east of the table against the east
    #              wall, one south of it (ends at y 3505, clear of the door swing from y 3855)
    furniture counter at (140, 3955) size 600x570 label "Abtropffläche" rotate 270
    furniture kitchen_sink at (140, 4525) size 600x430 label "Becken 43" rotate 270
    furniture counter at (140, 4955) size 600x330 rotate 270
    furniture counter at (140, 2525) size 600x830 rotate 270
    furniture dishwasher at (140, 3355) size 600x600 label "GS" rotate 270
    furniture counter at (140, 5285) size 600x600 rotate 270
    furniture counter at (740, 2525) size 1605x600
    furniture id=kaffeetisch table at (2345, 2525) size 600x600 label "Kaffeetisch"
    furniture stool at (3165, 2635) size 380x380 label "Hocker mit Griffmulde"
    furniture stool at (2455, 3125) size 380x380 label "Hocker mit Griffmulde"
    furniture counter at (740, 5285) size 400x600 rotate 180
    furniture stove at (1140, 5285) size 600x600 label "Kochfeld" rotate 180
    furniture range_hood at (1140, 5385) size 600x500 label "Dunstabzug" rotate 180
    furniture counter at (1740, 5285) size 1205x600 rotate 180
    furniture fridge at (2945, 5285) size 600x600 label "Kühlschrank" rotate 180
    # exhaust duct DN 100 from the hood along the south wall, 100 below the ceiling (clear
    # height 2340 -> at 2240 above the finished floor), to the outside through the west wall. ArchLang has no duct: drawn as a dimension line from the
    # hood centre to the outer face of the west wall, labelled
    dim (1440, 5835) -> (-140, 5835) offset 0 text "Abluft DN 100"
    # kitchen window, both casements drawn open at 45 deg for the window maker (does each leaf
    # pass the tap mid-window?): window 1070 = 2 x 65 frame + 2 leaves of 470 (measured), hinged
    # at y 4270 / 5210 on the frame: wall 280, inner reveal 210 deep to the frame (measured), so
    # the hinge line is x 140 - 210 = -70 -> tips at (262, 4602) and (262, 4878).
    # ArchLang draws windows closed only: the leaves are dimension lines labelled 45 deg.
    dim (-70, 4270) -> (262, 4602) offset 0 text "45°"
    dim (-70, 5210) -> (262, 4878) offset 0 text "45°"
    # bath fittings: ground floor only
    # bath fittings (measured): a level-access shower 90 x 90 in the north-east corner,
    # a corner bath with 130 cm legs in the north-west corner. ArchLang has no corner bath:
    # placeholder = the 45 deg triangle of its legs, inner corner (6335, 140): the legs are the
    # wall faces, the hypotenuse is drawn as a labelled dimension line (a wall there would
    # cut the triangle off the room)
    furniture shower in bad anchor top-right flush size 900x900 label "Dusche bodengleich 90/90"
    dim (7635, 140) -> (6335, 1440) offset 0 text "Eckwanne 130/130"
    # pre-wall on the bath's south wall (measured): 130 deep, 1300 high, the drains of WC and
    # basin run in it (drawn open); the Geberit frame in it sits 300 from the west wall and is
    # 500 wide, x 6635-7135 (drawn hatched)
    wall id=vormauer1 prewall thickness 130 material none height 1300 { (6335, 3730) (6635, 3730) }
    wall id=geberit prewall thickness 130 material poche height 1300 { (6635, 3730) (7135, 3730) }
    wall id=vormauer2 prewall thickness 130 material none height 1300 { (7135, 3730) (8770, 3730) }
    # shower WC hung on the pre-wall, centred on the frame
    furniture wc at (6685, 3065) size 400x600 label "Dusch-WC" rotate 180
    # basin on the pre-wall (position chosen: centre x 7700, 315 clear of the WC, 770 from the east wall)
    furniture basin at (7400, 3215) size 600x450 label "Waschbecken" rotate 180
  }
  level 1 "Obergeschoss" height OG_CLEAR + OG_SLAB {
    grundriss(1)
    door at (XH, 6855) width 800 wall partition swing into zw   # open leaf rests flush on the chimney face (y 6455)
    door at (XW, 10985) width 1000 wall exterior swing into wz
    # the shaft passes through this storey's floor slab
    void id=schacht at (SX, SY) size 410x410
  }

  notes "Wände aller Geschosse identisch, Raumnutzung je Geschoss"
        "Raumhöhen und Deckenaufbau gemessen 2026-11-06, Aufteilung Estrich/Beton angenommen"
        "EG Küche: Abluft DN 100 vom Dunstabzug zur Westwand, 10 cm unter der Decke"
  title { project "Haus KG/EG/OG" drawn_by "GH" date "2026-11-06" }
}
